---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { REPO_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Homelab Journal</h1>
			<p>
				I run a small Kubernetes cluster at home on mini PCs, managed end to end with GitOps. This
				blog covers how it's built, what broke, and what I learned fixing it.
			</p>
			<p>
				The configuration is public at <a href={REPO_URL}>{REPO_URL.replace('https://', '')}</a>.
			</p>
			<h2>Latest posts</h2>
			<ul>
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a> —{' '}
							<FormattedDate date={post.data.pubDate} />
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
